APP_ENV=development

# SQLite for the prototype; a PostgreSQL URL works unchanged (e.g. postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./krishimitra.db

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Sentinel Hub / Copernicus Data Space Ecosystem Statistical API (OAuth client credentials).
SENTINEL_CLIENT_ID=sh-2a237089-9386-4059-a5cb-563f382349aa
SENTINEL_CLIENT_SECRET=ouHAaVe9vLac36OnmC93N3YRn2dncQiYO2DxRlWEgw4mjBWjaCjdENkJkao8X0bbkp0GNKDAvHKqqAs3SRDKIG
SENTINEL_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_STATS_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics

# Google Gemini Flash API Key (Pre-configured fallback is already embedded in app/config.py; specify here only if overriding)
# GEMINI_API_KEY=your_gemini_api_key_here

# Prediction stays disabled unless explicitly enabled AND a validated artifact is installed
MODEL_ENABLED=false

# Allow /api/v1/risk/analyze to load DEMO fixtures via demo_fixture_id (results are flagged demo)
USE_DEMO_DATA=false

# Weather response cache freshness window in seconds (blank = 3600)
CACHE_TTL_SECONDS=3600

# TextBee Android SMS gateway (https://textbee.dev). Leave the key blank to use the mock gateway.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Comma-separated numbers: assigned to demo farmers in rotation; SMS goes ONLY to these.
SMS_ALLOWED_NUMBERS=
