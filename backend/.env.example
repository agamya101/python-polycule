APP_ENV=development

# SQLite for the prototype; a PostgreSQL URL works unchanged (e.g. postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./krishimitra.db

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Sentinel Hub / Copernicus Data Space Ecosystem Statistical API (OAuth client credentials).
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_STATS_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics

# Google Gemini Flash API Key (for regional SMS translation & Soil Health Card OCR)
GEMINI_API_KEY=

# Prediction stays disabled unless explicitly enabled AND a validated artifact is installed
MODEL_ENABLED=false

# Allow /api/v1/risk/analyze to load DEMO fixtures via demo_fixture_id (results are flagged demo)
USE_DEMO_DATA=false

# Weather response cache freshness window in seconds (blank = 3600)
CACHE_TTL_SECONDS=3600
